include("${CMAKE_CURRENT_LIST_DIR}/../cmake/release_version.cmake")
if(DEFINED BAD_BASE)
  community_release_version("01.2.3" 45 "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" FALSE version)
  message(FATAL_ERROR "Invalid base was accepted")
endif()
function(expect revision commit dirty expected)
  community_release_version("0.1.0" "${revision}" "${commit}" "${dirty}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected version '${actual}', wanted '${expected}'")
  endif()
endfunction()
set(commit "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa")
expect(45 "${commit}" FALSE "0.1.0-preview.45")
expect(46 "${commit}" FALSE "0.1.0-preview.46")
expect(45 "${commit}" TRUE "0.1.0-preview.45+dev.aaaaaaaa")
expect(0 "${commit}" FALSE "0.1.0-dev.0+unknown")
expect(45 unknown FALSE "0.1.0-dev.0+unknown")
execute_process(COMMAND "${CMAKE_COMMAND}" -DBAD_BASE=ON -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT error MATCHES "Release base must")
  message(FATAL_ERROR "Invalid numeric version was not rejected by validation")
endif()
message(STATUS "Clean, dirty, source-less and invalid version cases passed")
