cmake_path(ABSOLUTE_PATH CMAKE_INSTALL_PREFIX NORMALIZE OUTPUT_VARIABLE inventory_root)
set(records "[]")
set(index 0)
list(REMOVE_DUPLICATES CMAKE_INSTALL_MANIFEST_FILES)
list(SORT CMAKE_INSTALL_MANIFEST_FILES)
foreach(installed IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
  cmake_path(ABSOLUTE_PATH installed NORMALIZE OUTPUT_VARIABLE installed)
  file(RELATIVE_PATH relative "${inventory_root}" "${installed}")
  if(relative STREQUAL "install-inventory.json")
    continue()
  endif()
  if(relative MATCHES "^\\.\\." OR IS_DIRECTORY "${installed}")
    message(FATAL_ERROR "Unexpected install inventory path: ${relative}")
  endif()
  file(SHA256 "${installed}" digest)
  file(SIZE "${installed}" bytes)
  string(JSON record SET "{}" path "\"${relative}\"")
  string(JSON record SET "${record}" sha256 "\"${digest}\"")
  string(JSON record SET "${record}" bytes "${bytes}")
  string(JSON records SET "${records}" ${index} "${record}")
  math(EXPR index "${index} + 1")
endforeach()
string(JSON inventory SET "{\"schema\":1}" files "${records}")
file(WRITE "${inventory_root}/install-inventory.json" "${inventory}\n")
